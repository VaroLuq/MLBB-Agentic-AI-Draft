.env
venv/
__pycache__/
*.pyc

# Machine-generated CA bundle (certifi + local AV root cert) — see
# .env's REQUESTS_CA_BUNDLE comment. Regenerated per-machine, not
# portable (embeds this machine's AV-specific cert), so not committed.
certs/

vectorstore/*
!vectorstore/.gitkeep

data/raw/*
!data/raw/.gitkeep

# data/snapshots/ is DELIBERATELY tracked (not ignored), unlike the
# other data/ subfolders — the GitHub Actions workflow
# (.github/workflows/meta-watcher.yml) commits snapshots and
# drift_log.txt back into the repo on every scheduled run. Git IS the
# database for Meta-Watcher's history; see that workflow's comments.

data/eval_results/*
!data/eval_results/.gitkeep

misc/*
misc/

.DS_Store

# Tailwind standalone CLI (112 MB binary) — download it into tools/ to
# rebuild src/web/static/app.css; the built CSS itself IS committed.
tools/

# Impeccable working artifacts: review screenshots and decision-page state are
# regenerated per run. The surface brief (.impeccable/surfaces/) and, once
# written, .impeccable/design.json stay tracked.
.impeccable/review/
.impeccable/questions/

JEV.md
LAYA.md
