# No API key needed for Rone Arena's heroes/academy endpoints — they're
# public. This is only here in case you later add the high-volume host
# or hit rate limits and want to switch hosts without touching code.
RONE_ARENA_BASE_URL=https://arena.rone.dev/api

# Only needed if outbound HTTPS requests fail with
# "SSLCertVerificationError: unable to get local issuer certificate".
# This usually means an antivirus/corporate proxy is doing HTTPS
# inspection and Python's `requests` library doesn't trust its
# injected root CA by default (even though your OS/browser does).
#
# DO NOT point this directly at the AV's cert file — that REPLACES
# Python's entire trusted root store with just that one cert, so any
# domain the AV *isn't* intercepting (e.g. one you've excluded from
# scanning) will then fail the opposite way, since its real public CA
# is no longer trusted either. Instead, build a combined bundle: your
# AV's exported CA + certifi's normal public CA bundle, concatenated:
#   mkdir certs
#   cat venv/Lib/site-packages/certifi/cacert.pem "<path to your AV's exported .pem/.crt>" > certs/combined_ca_bundle.pem
# Then point this at the combined file (use an absolute path — some
# entry points in this project may not share the same working
# directory):
# REQUESTS_CA_BUNDLE=C:\path\to\this\project\certs\combined_ca_bundle.pem

# Jev — the decision model that ranks draft candidates. Required.
# Calls cost roughly $0.0002 each.
OPEN_JEV_KEY=
# Defaults, only set these to override:
# OPEN_JEV_URL=https://api.openjev.sh/v1/systemone
# OPEN_JEV_MODEL=openjev

# Local LLM (Ollama) — NO LONGER USED. The draft agent used to generate
# recommendations with qwen2.5:3b; Jev replaced it and nothing in the
# pipeline imports src/agents/llm.py any more. Kept only so an existing
# .env doesn't break, and because /api/health still reports on Ollama.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# Local vector store + embeddings (for narrative guide content only).
# NOTE: changing EMBEDDING_MODEL requires re-running `python -m src.rag.ingest`
# — a dimension mismatch against the existing collection fails silently at
# query time, and it also invalidates RAG_RELEVANCE_THRESHOLD in
# src/rag/scoring.py, which is calibrated per embedder.
CHROMA_PERSIST_DIR=./vectorstore
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
